{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Espn": {
        "BaseUrl": "https://site.api.espn.com/apis/site/v2/sports/"
    },
    "Cache": {
        "WorkerRefreshSeconds": 15,
        "LiveScoreboardSeconds": 15,
        "ScheduledScoreboardMinutes": 2,
        "FinalScoreboardMinutes": 30,
        "TeamMinutes": 60,
        "StandingsMinutes": 60   
    }
}