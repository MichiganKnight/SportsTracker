@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h2 class="mb-1">
                Today's Games
            </h2>
            
            <p class="text-secondary mb-0">
                Live Scoreboards from Every Supported League
            </p>
        </div>
    </div>
    
    @foreach (var league in Model.Leagues)
    {
        <div id="league-@league.League.ToString().ToLowerInvariant()">
            <partial name="_LeagueSection" model="league" />
        </div>
    }
</div>