@model SportsTracker.Frontend.ViewModels.GameDetails.GameDetailsViewModel

@{
    ViewData["Title"] = $"{Model.AwayTeam.Abbreviation} at {Model.HomeTeam.Abbreviation}";
}

<div class="container-fluid">
    <div id="game-details-@Model.GameId" data-game-details data-game-id="@Model.GameId" data-league="@Model.League">
        <partial name="Game/_GameDetailsContent" model="Model" />
    </div>
</div>