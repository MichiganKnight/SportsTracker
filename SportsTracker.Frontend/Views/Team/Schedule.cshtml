@using SportsTracker.Frontend.ViewModels.GameInfo
@model SportsTracker.Frontend.ViewModels.TeamInfo.TeamSchedulePageViewModel

@{
    ViewData["Title"] = $"{Model.Team.Team.DisplayName} Schedule";
    ViewData["ActiveTeamTab"] = "Schedule";
    
    var months = Model.Games
        .GroupBy(game => new
        {
            game.StartTime.Year,
            game.StartTime.Month
        })
        .OrderBy(group => group.Key.Year)
        .ThenBy(group => group.Key.Month);
}

<div class="container-fluid">
    <partial name="Game/_TeamHeader" model="Model.Team" />
    
    <partial name="Game/_TeamNavigation" model="Model.Team" />
    
    @foreach (var month in months)
    {
        DateTime monthDate = new(month.Key.Year, month.Key.Month, 1);
        
        <section class="mb-5">
            <h4 class="mb-3">
                @monthDate.ToString("MMMM yyyy")
            </h4>
            
            <div class="row g-3">
                @foreach (GameCardViewModel game in month)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <partial name="Game/_GameCard" model="game" />
                    </div>
                }
            </div>
        </section>
    }
</div>