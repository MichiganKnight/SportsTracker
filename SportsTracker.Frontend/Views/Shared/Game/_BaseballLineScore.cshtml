@using SportsTracker.Frontend.ViewModels.GameDetails
@model SportsTracker.Frontend.ViewModels.GameDetails.GameDetailsViewModel

@{
    int maxInning = Math.Max(9, Math.Max(
            Model.AwayTeam.LineScores.Count == 0
                ? 0
                : Model.AwayTeam.LineScores.Max(x => x.Period),

            Model.HomeTeam.LineScores.Count == 0
                ? 0
                : Model.HomeTeam.LineScores.Max(x => x.Period)
        )
    );
}

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h5 class="mb-0">
            Line Score
        </h5>
    </div>
    
    <div class="table-responsive">
        <table class="table align-middle mb-0 game-linescore">
            <thead>
                <tr>
                    <th>Team</th>

                    @for (int inning = 1; inning <= maxInning; inning++)
                    {
                        <th class="text-center">
                            @inning
                        </th>
                    }

                    <th class="text-center fw-bold">R</th>
                    <th class="text-center">H</th>
                    <th class="text-center">E</th>
                </tr>
            </thead>
            
            <tbody>
                <partial name="Game/_BaseballLineScoreRow"
                         model="new BaseballLineScoreRowViewModel
                         {
                             Team = Model.AwayTeam,
                             MaxInning = maxInning,
                             IsHomeTeam = false
                         }" />

                <partial name="Game/_BaseballLineScoreRow"
                         model="new BaseballLineScoreRowViewModel
                         {
                             Team = Model.HomeTeam,
                             MaxInning = maxInning,
                             IsHomeTeam = true
                         }" />
            </tbody>
        </table>
    </div>
</div>