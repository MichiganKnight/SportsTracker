@using SportsTracker.Frontend.ViewModels.GameDetails

@if (Model.FeaturedAthletes.Count > 0)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                Game Leaders
            </h5>
        </div>
            
        <div class="card-body">
            <div class="row g-3">
                @foreach (FeaturedAthleteViewModel athlete in Model.FeaturedAthletes)
                {
                    <div class="col-md-4">
                        <div class="game-featured-athlete">
                            @if (!string.IsNullOrWhiteSpace(athlete.Headshot))
                            {
                                <img src="@athlete.Headshot" alt="@athlete.Name" class="game-featured-athlete-image" />
                            }
                                
                            <div>
                                <div class="text-secondary small">
                                    @athlete.Label
                                </div>
                                    
                                <div class="fw-semibold">
                                    @athlete.Name
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}