@using SportsTracker.Frontend.ViewModels.BoxScore
@model SportsTracker.Frontend.ViewModels.GameInfo.GamePageViewModel<BoxScoreViewModel>

@{
    ViewData["ActiveGameTab"] = "BoxScore";
}

<partial name="Game/_GameHeader" model="Model.Game" />
    
<partial name="Game/_GameNavigation" model="Model.Game" />

@foreach (TeamBoxScoreViewModel team in Model.Content.Teams)
{
    <div class="card shadow-sm mb-4">
        <!-- Team Header -->
        <div class="card-header boxscore-team-header">
            <div class="d-flex align-items-center gap-2">
                @if (!string.IsNullOrWhiteSpace(team.Logo))
                {
                    <img src="@team.Logo" alt="@team.TeamName" class="boxscore-team-logo"/>
                }

                <div>
                    <h4 class="mb-0">
                        @team.TeamName
                    </h4>

                    <div class="text-secondary small">
                        @team.Abbreviation
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @foreach (PlayerStatTableViewModel table in team.Tables)
            {
                <partial name="Game/_PlayerStatTable" model="table"/>
            }
        </div>
    </div>
}

