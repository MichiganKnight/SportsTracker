@model SportsTracker.Frontend.ViewModels.GameInfo.GameCardViewModel

@if (Model.Baseball is not null && Model.IsLive)
{
    <div class="game-situation baseball-situation mt-3">
        <div class="baseball-live-info">
            <partial name="Game/_BaseballDiamond" model="Model.Baseball" />
                
            <!--@if (Model.Baseball.Batter is not null || Model.Baseball.Pitcher is not null)
            {
                <div class="baseball-batter-pitcher">
                    @if (Model.Baseball.Batter is not null)
                    {
                        <span>
                            <strong>BAT</strong>
                            @Model.Baseball.Batter.Name
                        </span>
                    }
                    
                    @if (Model.Baseball.Pitcher is not null)
                    {
                        <span>
                            <strong>P</strong>
                            @Model.Baseball.Pitcher.Name
                        </span>
                    }
                </div>
            }-->
                
            @if (!string.IsNullOrWhiteSpace(Model.SituationDetail))
            {
                <div class="game-last-play mt-2 text-secondary">
                    @Model.SituationDetail
                </div>
            }
        </div>
    </div>
}