@using SportsTracker.Shared.Models
@using SportsTracker.Shared.Models.Sport
@model SportsTracker.Frontend.ViewModels.GameInfo.GameCardViewModel

@{
    BaseballSituation? baseball = Model.Baseball;

    bool hasDueUp = baseball?.DueUp.Count > 0;
    bool hasLastPlay = !string.IsNullOrWhiteSpace(Model.SituationDetail);
}

@if (baseball is not null && Model.IsLive)
{
    <div class="game-situation baseball-situation mt-3">
        <div class="baseball-live-info">
            <div class="baseball-diamond-wrap">
                <partial name="Game/_BaseballDiamond" model="baseball" />
            </div>

            <!-- Due Up -->
            @if (hasDueUp)
            {
                <div class="baseball-due-up">
                    <span class="baseball-section-label text-secondary">
                        Due Up
                    </span>

                    <div class="baseball-due-up-list">
                        @foreach (Athlete athlete in baseball.DueUp.Take(3))
                        {
                            <span class="baseball-due-up-player text-secondary">
                                @DisplayName(athlete)
                            </span>
                        }
                    </div>
                </div>
            }

            <!-- Last Play -->
            @if (hasLastPlay)
            {
                <div class="game-last-play">
                    <span class="baseball-section-label text-secondary">
                        Last Play
                    </span>

                    <span class="game-last-play-text text-secondary">
                        @Model.SituationDetail
                    </span>
                </div>
            }
        </div>
    </div>
}

@functions
{
    private static string DisplayName(Athlete athlete)
    {
        return athlete.ShortName ?? athlete.Name;
    }
}