@model SportsTracker.Frontend.ViewModels.GameInfo.GameCardViewModel

@if (Model.IsLive && Model.Baseball is not null)
{
    <div class="game-count mt-3">
        <div>
            <div class="game-count">
                Count
                
                @Model.Baseball.Balls-@Model.Baseball.Strikes
                
                •
                
                @Model.Baseball.Outs Out@(Model.Baseball.Outs == 1 ? "" : "s")
            </div>
            
            @if (!string.IsNullOrWhiteSpace(Model.SituationDetail))
            {
                <div class="game-last-play mt-2">
                    @Model.SituationDetail
                </div>
            }
        </div>
        
        <div class="baseball-situation">
            <partial name="Game/_BaseballDiamond" model="Model.Baseball" />
        </div>
    </div>
}