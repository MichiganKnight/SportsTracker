@model SportsTracker.Frontend.ViewModels.GameInfo.GameCardViewModel

@{
    bool showVenue = !string.IsNullOrWhiteSpace(Model.Venue);
}

<div class="card game-card shadow-sm h-100">
    <div class="card-body">
        <!-- Teams -->
        <div class="rounded-3 p-2 mb-3 bg-body-tertiary">
            @await Html.PartialAsync("_TeamRow", Model.AwayTeam)
            @await Html.PartialAsync("_TeamRow", Model.HomeTeam)
        </div>
        
        <div class="border-top pt-3">
            <!-- Status -->
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    @if (Model.IsLive)
                    {
                        <span class="bg-danger">
                            LIVE
                        </span>
                    }
                    else if (Model.IsFinal)
                    {
                        <span class="badge bg-dark">
                            FINAL
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary">
                            SCHEDULED
                        </span>
                    }
                    
                    <span class="fw-semibold">
                        @(Model.SituationHeadline ?? Model.Status)
                    </span>
                </div>
                
                @if (!string.IsNullOrWhiteSpace(Model.SituationSubheadline))
                {
                    <span class="small text-secondary fw-semibold">
                        @Model.SituationSubheadline
                    </span>
                }
            </div>
            
            @if (Model.Baseball is not null)
            {
                <div class="game-situation">
                    <partial name="Game/_BaseballSituation" model="Model" />
                </div>
            }
            
            @if (showVenue)
            {
                <div class="border-top mt-3 pt-2 small text-secondary">
                    <i class="bi bi-geo-alt-fill me-1"></i>
                    @Model.Venue
                </div>
            }
        </div>
    </div>
</div>