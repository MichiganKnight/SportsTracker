@model SportsTracker.Frontend.ViewModels.GameDetails.GameDetailsViewModel

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <h5 class="mb-0">
                    Game Information
                </h5>
            </div>

            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Venue))
                {
                    <div class="game-detail-info-row">
                        <span class="text-secondary">Venue</span>
                        <span>@Model.Venue</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Location))
                {
                    <div class="game-detail-info-row">
                        <span class="text-secondary">Location</span>
                        <span>@Model.Location</span>
                    </div>
                }

                <div class="game-detail-info-row">
                    <span class="text-secondary">Date</span>
                    <span>@Model.StartTime.ToString("g")</span>
                </div>

                @if (Model.Attendance.HasValue)
                {
                    <div class="game-detail-info-row">
                        <span class="text-secondary">Attendance</span>
                        <span>@Model.Attendance.Value.ToString("N0")</span>
                    </div>
                }

                @if (Model.Broadcasts.Count > 0)
                {
                    <div class="game-detail-info-row">
                        <span class="text-secondary">Broadcast</span>
                        <span>@string.Join(", ", Model.Broadcasts)</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.Baseball is not null)
    {
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        Starting Pitchers
                    </h5>
                </div>

                <div class="card-body">
                    <div class="game-detail-info-row">
                        <span class="text-secondary">@Model.AwayTeam.Abbreviation</span>

                        <span>
                            @(Model.Baseball.AwayProbablePitcherName ?? "-")

                            @if (!string.IsNullOrWhiteSpace(Model.Baseball.AwayProbablePitcherRecord))
                            {
                                <span class="text-secondary ms-1">
                                    @Model.Baseball.AwayProbablePitcherRecord
                                </span>
                            }
                        </span>
                    </div>

                    <div class="game-detail-info-row">
                        <span class="text-secondary">@Model.HomeTeam.Abbreviation</span>

                        <span>
                            @(Model.Baseball.HomeProbablePitcherName ?? "-")

                            @if (!string.IsNullOrWhiteSpace(Model.Baseball.HomeProbablePitcherRecord))
                            {
                                <span class="text-secondary ms-1">@Model.Baseball.HomeProbablePitcherRecord</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>