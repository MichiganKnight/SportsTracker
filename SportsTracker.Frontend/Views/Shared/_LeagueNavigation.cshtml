@using SportsTracker.Shared.Enums
@model SportsTracker.Frontend.ViewModels.LeagueInfo.LeagueNavigationViewModel

@{
    bool gamesActive = Model.ActivePage == LeaguePage.Games;
    bool standingsActive = Model.ActivePage == LeaguePage.Standings;
}

<div class="btn-group standings-view-filter" role="group" aria-label="@Model.LeagueName Navigation">
    <a asp-controller="League" asp-action="Index" asp-route-league="@Model.League" class="btn @(gamesActive ? "btn-primary" : "btn-outline-secondary")">
        <i class="bi bi-calendar-event me-1"></i>
        Games
    </a>
    
    <a asp-controller="Standings" asp-action="Index" asp-route-league="@Model.League" class="btn @(standingsActive ? "btn-primary" : "btn-outline-secondary")">
        <i class="bi bi-list-ol me-1"></i>
        Standings
    </a>
</div>