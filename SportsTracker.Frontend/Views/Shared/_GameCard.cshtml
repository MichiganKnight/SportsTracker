@model SportsTracker.Frontend.ViewModels.Dashboard.GameCardViewModel

<div class="card game-card shadow-sm">
    <div class="card-body">
        <partial name="_TeamRow" model="Model.AwayTeam" />
        <partial name="_TeamRow" model="Model.HomeTeam" />

        <hr/>

        <div class="d-flex justify-content-between align-items-center">
            <small class="text-secondary">
                @Model.Status
            </small>

            @if (Model.IsLive)
            {
                <span class="badge bg-danger">
                    LIVE
                </span>
            }
        </div>
    </div>
</div>