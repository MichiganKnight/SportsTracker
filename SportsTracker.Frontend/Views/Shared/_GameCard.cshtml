@model SportsTracker.Frontend.ViewModels.GameCardViewModel

<div class="card game-card h-100">
    <div class="card-body">
        <div class="team-row">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrWhiteSpace(Model.AwayTeam.Logo))
                {
                    <img src="@Model.AwayTeam.Logo" width="24" height="24" class="me-2" alt="@Model.AwayTeam.Name" />
                }
                
                <span>@Model.AwayTeam.Name</span>
            </div>
            
            <span class="team-score">
                @Model.AwayTeam.Score
            </span>
        </div>
        
        <div class="team-row">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrWhiteSpace(Model.HomeTeam.Logo))
                {
                    <img src="@Model.HomeTeam.Logo" width="24" height="24" class="me-2" alt="@Model.HomeTeam.Name" />
                }
                
                <span>@Model.HomeTeam.Name</span>
            </div>
            
            <span class="team-score">
                @Model.HomeTeam.Score
            </span>
        </div>
        
        <hr />
        
        <div class="d-flex justify-content-between">
            <small class="text-secondary">
                @Model.Status
            </small>
            
            @if (Model.IsLive)
            {
                <span class="badge bg-danger">
                    LIVE
                </span>
            }
        </div>
    </div>
</div>