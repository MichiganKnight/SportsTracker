@model SportsTracker.Frontend.ViewModels.TeamInfo.TeamViewModel

@{
    string? primaryColor = string.IsNullOrWhiteSpace(Model.PrimaryColor) ? null : $"#{Model.PrimaryColor}";
    string? alternateColor = string.IsNullOrWhiteSpace(Model.AlternateColor) ? null : $"#{Model.AlternateColor}";
}

<div class="d-flex justify-content-between align-items-center py-2">
    <a asp-controller="Team" asp-action="Index" asp-route-league="@Model.League" asp-route-teamId="@Model.Id" class="team-link d-flex align-items-center gap-2 position-relative z-2">
        @if (!string.IsNullOrWhiteSpace(Model.Logo))
        {
            <div class="team-row-logo-wrapper" style="@(primaryColor is not null ? $"--team-accent: {primaryColor};" : null)">
                <img class="team-logo img-fluid" src="@Model.Logo" alt="@Model.DisplayName" />
            </div>
        }
        else
        {
            <div class="team-logo-placeholder rounded-circle" style="@(alternateColor is not null ? $"background-color: {alternateColor};" : null)"></div>
        }
        
        <div>
            <div class="fw-bold team-row-name">
                @Model.DisplayName
            </div>
            
            @if (!string.IsNullOrWhiteSpace(Model.Record))
            {
                <small class="text-secondary">
                    @Model.Record
                </small>
            }
        </div>
    </a>
    
    <div class="fw-bold fs-4">
        <div class="team-score" data-team-score>
            @Model.Score
        </div>
    </div>
</div>