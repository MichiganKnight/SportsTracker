@model SportsTracker.Frontend.ViewModels.TeamInfo.TeamViewModel

<div class="d-flex justify-content-between align-items-center py-2">
    <a asp-controller="Team" asp-action="Index" asp-route-league="@Model.League" asp-route-teamId="@Model.Id" class="team-link d-flex align-items-center gap-2 position-relative z-2">
        @if (!string.IsNullOrWhiteSpace(Model.Logo))
        {
            <img class="team-logo img-fluid" src="@Model.Logo" alt="@Model.DisplayName" />
        }
        else
        {
            <div class="team-logo-placeholder rounded-circle" style="width: 36px; height: 36px; background-color: #@Model.AlternateColor;"></div>
        }
        
        <div>
            <div class="fw-semibold" style="color: #@Model.PrimaryColor;">
                @Model.DisplayName
            </div>
            
            @if (!string.IsNullOrWhiteSpace(Model.Record)) {
                <small class="text-secondary">
                    @Model.Record
                </small>
            }
        </div>
    </a>
    
    <div class="fw-bold fs-4" style="color: #@Model.PrimaryColor;">
        <div class="team-score" data-team-score>
            @Model.Score
        </div>
    </div>
</div>