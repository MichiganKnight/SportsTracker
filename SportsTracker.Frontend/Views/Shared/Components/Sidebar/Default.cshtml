@using SportsTracker.Frontend.ViewModels.NavigationInfo
@model IReadOnlyList<SportsTracker.Frontend.ViewModels.NavigationInfo.NavigationItemViewModel>

<div class="list-group list-group-flush">
    <div class="sidebar-header">
        GENERAL
    </div>
    
    <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action">
        🏠 Dashboard
    </a>
    
    <a asp-controller="" class="list-group-item list-group-item-action">
        📅 Today's Games
    </a>
    
    <div class="sidebar-header mt-4">
        LEAGUES
    </div>
    
    @foreach (NavigationItemViewModel league in Model)
    {
        <a asp-controller="League" asp-action="Index" asp-route-league="@league.League" class="list-group-item list-group-item-action">
            <span class="me-2">@league.Icon</span>
            
            @league.Name
        </a>
    }
</div>