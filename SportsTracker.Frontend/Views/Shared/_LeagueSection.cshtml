@using SportsTracker.Frontend.ViewModels.Dashboard
@model SportsTracker.Frontend.ViewModels.Dashboard.LeagueSectionViewModel

<section class="mb-5">
    <div class="league-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">
            @Model.Icon @Model.LeagueName
            <small class="text-secondary">
                (@Model.GameCount)
            </small>
        </h3>
        
        <a href="@Model.Route" class="btn btn-outline-secondary">
            View All <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    
    @if (!Model.HasGames)
    {
        <div class="card">
            <div class="card-body text-secondary">
                No Games Scheduled
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (GameCardViewModel game in Model.Games)
            {
                <div class="col-xl-4 col-lg-6">
                    <partial name="_GameCard" model="game" />
                </div>
            }
        </div>
    }
    
    @if (Model.HasMoreGames)
    {
        <div class="text-center mt-3">
            <small class="text-body-secondary">
                Showing @Model.DisplayedGames of @Model.TotalGames Games
            </small>
        </div>
    }
</section>