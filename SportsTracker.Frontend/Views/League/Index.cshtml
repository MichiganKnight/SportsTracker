@model SportsTracker.Frontend.ViewModels.LeagueInfo.LeaguePageViewModel

@{
    ViewData["Title"] = Model.LeagueName;
}

<div class="container-fluid">
    <!-- League Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @Model.LeagueName
            </h1>

            <div class="text-secondary">
                Games
            </div>
        </div>

        <div class="btn-group" role="group" aria-label="League Navigation">
            <a asp-controller="League" asp-action="Index" asp-route-league="@Model.League" class="btn btn-primary">
                <i class="bi bi-calendar-event me-1"></i>
                Games
            </a>

            <a asp-controller="Standings" asp-action="Index" asp-route-league="@Model.League" class="btn btn-outline-secondary">
                <i class="bi bi-list-ol me-1"></i>
                Standings
            </a>
        </div>
    </div>

    <!-- Last Updated -->
    <div class="mb-4 text-secondary small">
        Updated @Model.LastUpdatedUtc.ToLocalTime()
    </div>

    <!-- Game Sections -->
    
    <partial name="Game/_GameSection" model="Model.Live" />
    <partial name="Game/_GameSection" model="Model.Upcoming" />
    <partial name="Game/_GameSection" model="Model.Final" />
</div>