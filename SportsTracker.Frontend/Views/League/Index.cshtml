@model SportsTracker.Frontend.ViewModels.Pages.LeaguePageViewModel

<div class="mb-4">
    <h1>
        <i class="@Model.Icon me-2"></i>
        
        @Model.LeagueName
    </h1>
    
    <div class="text-secondary">
        Updated
        
        @Model.LastUpdatedUtc.ToLocalTime()
    </div>
</div>

<hr />

<h4>Live Games (@Model.LiveCount)</h4>

<hr />

<h4>Upcoming Games (@Model.UpcomingCount)</h4>

<hr />

<h4>Final Games (@Model.FinalCount)</h4>