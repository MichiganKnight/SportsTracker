@using SportsTracker.Frontend.ViewModels.LeagueInfo
@using SportsTracker.Shared.Enums
@model SportsTracker.Frontend.ViewModels.LeagueInfo.LeaguePageViewModel

@{
    ViewData["Title"] = Model.LeagueName;
}

<div class="container-fluid">
    <!-- League Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @Model.LeagueName
            </h1>

            <div class="text-secondary">
                Games
            </div>
        </div>

        <partial name="_LeagueNavigation" model="new LeagueNavigationViewModel
                 {
                     League = Model.League,
                     LeagueName = Model.LeagueName,
                     ActivePage = LeaguePage.Games
                 }"/>
    </div>

    <!-- Last Updated -->
    <div class="mb-4 text-secondary small">
        Updated @Model.LastUpdatedUtc.ToLocalTime()
    </div>

    <!-- Game Sections -->
    <partial name="Game/_LeagueGameSections" model="Model" />
</div>