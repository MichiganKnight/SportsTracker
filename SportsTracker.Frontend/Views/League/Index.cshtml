@model SportsTracker.Frontend.ViewModels.Pages.LeaguePageViewModel

@{
    ViewData["Title"] = Model.LeagueName;
}

<div class="container-fluid league-@Model.League.ToString().ToLowerInvariant()">
    <div class="mb-4">
        <h1>
            <span class="me-2">@Model.Icon</span>
        
            @Model.LeagueName
        </h1>
    
        <div class="text-secondary">
            Updated @Model.LastUpdatedUtc.ToLocalTime()
        </div>
    </div>
    
    <partial name="_GameSection" model="Model.Live" />
    <partial name="_GameSection" model="Model.Upcoming" />
    <partial name="_GameSection" model="Model.Final" />
</div>