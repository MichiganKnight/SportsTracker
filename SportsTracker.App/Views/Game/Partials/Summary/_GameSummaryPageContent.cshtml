@inject IWebHostEnvironment HostEnvironment
@using SportsTracker.App.Enums
@model SportsTracker.App.ViewModels.GameDetails.GameDetailsViewModel

@{
    ViewData["ActiveGameTab"] = "Summary";
    
    bool showNflField = Model.League == League.NFL && (Model.IsLive || (Model.IsFinal && HostEnvironment.IsDevelopment()));
}

<div id="game-summary-@Model.GameId" data-game-summary-page data-league="@Model.League" data-game-id="@Model.GameId">
    <partial name="~/Views/Game/Partials/_GameHeader.cshtml" model="Model" />
    
    <partial name="~/Views/Game/Partials/_GameNavigation.cshtml" model="Model" />
    
    <div id="summary">
        @if (Model.Baseball is not null)
        {
            <partial name="~/Views/Game/Partials/Sport/Baseball/_BaseballLineScore.cshtml" model="Model" />    
        }
        
        @if (showNflField)
        {
            <partial name="~/Views/Game/Partials/Sport/Football/_FootballFieldDetails.cshtml" model="Model" />
        }
        else if (Model.League == League.MLB && Model.IsLive)
        {
            <partial name="~/Views/Game/Partials/Sport/Baseball/_BaseballDiamondDetails.cshtml" model="Model" />
        }
        else if (Model.League == League.NHL)
        {
            <partial name="~/Views/Game/Partials/Sport/Hockey/_HockeyRink.cshtml" model="Model" />   
        }
        
        <partial name="~/Views/Game/Partials/Summary/_GameInformation.cshtml" model="Model" />
        
        @if (Model.FeaturedAthletes.Count > 0)
        {
            <partial name="~/Views/Game/Partials/Summary/_FeaturedAthletes.cshtml" model="Model" />        
        }
        
        @if (!string.IsNullOrWhiteSpace(Model.Headline) || !string.IsNullOrWhiteSpace(Model.Recap))
        {
            <partial name="~/Views/Game/Partials/Summary/_GameSummary.cshtml" model="Model" />
        }
    </div>
</div>