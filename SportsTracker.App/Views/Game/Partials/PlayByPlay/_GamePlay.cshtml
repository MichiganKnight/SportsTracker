@model SportsTracker.App.ViewModels.PlayByPlay.GamePlayViewModel

@{
    string? teamColor = ViewData["TeamColor"] as string;
    string? teamSide = ViewData["TeamSide"] as string;
    
    string? playStyle = !string.IsNullOrWhiteSpace(teamColor) ? $"--play-team-color: #{teamColor};" : null;
}

<div class="game-play @(Model.ScoringPlay ? "game-play-scoring" : "") @(teamSide is not null ? "game-play-team" : "")" style="@playStyle" data-game-play data-play-id="@Model.Id" data-play-category="@Model.Category.ToLowerInvariant()" data-play-team="@teamSide">
    <div class="game-play-main">
        <div class="game-play-marker">
            @if (Model.ScoringPlay)
            {
                <i class="bi bi-circle-fill"></i>
            }
            else
            {
                <i class="bi bi-circle-fill text-secondary"></i>
            }
        </div>
        
        <div class="game-play-content">
            @if (!string.IsNullOrWhiteSpace(Model.Situation) || !string.IsNullOrWhiteSpace(Model.Clock))
            {
                <div class="game-play-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.Clock))
                    {
                        <span class="game-play-clock">
                            @Model.Clock
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Situation))
                    {
                        <span class="game-play-situation">
                            @Model.Situation
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Context))
                    {
                        <span class="game-play-context">
                            @Model.Context
                        </span>
                    }
                </div>
            }
            
            @if (!string.IsNullOrWhiteSpace(Model.Text))
            {
                <div class="game-play-text">
                    @Model.Text
                </div>
            }
        </div>
        
        @if (Model.AwayScore.HasValue && Model.HomeScore.HasValue && Model.ScoringPlay)
        {
            <div class="game-play-score">
                @Model.AwayScore - @Model.HomeScore
            </div>
        }
    </div>
</div>