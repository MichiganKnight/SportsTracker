
@using SportsTracker.App.Models.Sport
@model SportsTracker.App.ViewModels.GameDetails.GameDetailsViewModel

@{
    BaseballSituation game = Model.BaseballSituation ?? new BaseballSituation();

    bool hasSituation = Model.BaseballSituation is not null;
}

<section class="card shadow-sm mb-4 sport-details">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">On the Diamond</h5>
        
        <span class="small text-secondary">@Model.Status</span>
    </div>

    <div class="card-body">

        @if (!hasSituation)
        {
            <p class="text-secondary small mb-2">
                Runner and Count Information is Unavailable
            </p>
        }

        <div class="baseball-detail-layout">
            <svg viewBox="0 0 200 180" class="baseball-detail-svg" role="img" aria-label="Baseball diamond showing occupied bases">
                <path d="M100 20L177 95L100 165L23 95Z" fill="#a98153" />
                <path d="M100 45L151 95L100 143L49 95Z" fill="#317d57" />
                <path d="M100 20L177 95M100 20L23 95" stroke="white" stroke-width="2" />

                <!-- Second Base -->
                <rect x="94" y="14" width="12" height="12" transform="rotate(45 100 20)" fill="@(hasSituation && game.OnSecond ? "#ffc107" : "white")" />

                <!-- First Base -->
                <rect x="171" y="89" width="12" height="12" transform="rotate(45 177 95)" fill="@(hasSituation && game.OnFirst ? "#ffc107" : "white")" />

                <!-- Third Base -->
                <rect x="17" y="89" width="12" height="12" transform="rotate(45 23 95)" fill="@(hasSituation && game.OnThird ? "#ffc107" : "white")" />

                <!-- Home Plate -->
                <path d="M93 158L100 165L107 158L107 153L93 153Z" fill="white" />

                <!-- Pitcher's Mound -->
                <circle cx="100" cy="102" r="6" fill="#d5bb8a" />
            </svg>

            <div class="baseball-detail-stats">
                <div class="fs-4 fw-bold">
                    @(game.Balls?.ToString() ?? "–")–@(game.Strikes?.ToString() ?? "–")
                </div>

                <div class="text-secondary small">
                    Balls – Strikes
                </div>

                <div class="mt-3">
                    <strong>@(game.Outs?.ToString() ?? "–")</strong> Outs
                </div>

                <div class="mt-2 small text-secondary">
                    Highlighted Bases Indicate Runners
                </div>
            </div>
        </div>

        @if (game.Batter is not null || game.Pitcher is not null)
        {
            <div class="row g-3 border-top mt-3 pt-3">
                @if (game.Batter is not null)
                {
                    <div class="col-md-6">
                        <div class="small text-secondary mb-1">
                            At Bat
                        </div>

                        <div class="fw-semibold">
                            @game.Batter.Name
                        </div>

                        @if (!string.IsNullOrWhiteSpace(game.Batter.Jersey))
                        {
                            <div class="small text-secondary">
                                #@game.Batter.Jersey
                            </div>
                        }
                    </div>
                }

                @if (game.Pitcher is not null)
                {
                    <div class="col-md-6">
                        <div class="small text-secondary mb-1">
                            Pitching
                        </div>

                        <div class="fw-semibold">
                            @game.Pitcher.Name
                        </div>

                        @if (!string.IsNullOrWhiteSpace(game.Pitcher.Jersey))
                        {
                            <div class="small text-secondary">
                                #@game.Pitcher.Jersey
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (game.DueUp?.Count > 0)
        {
            <div class="border-top mt-3 pt-3">
                <div class="small text-secondary mb-1">
                    Due Up
                </div>

                <div class="small">
                    @string.Join(" - ", game.DueUp.Select(athlete => athlete.Name))
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(game.LastPlay))
        {
            <div class="border-top mt-3 pt-3">
                <strong>Latest Play</strong>

                <div class="text-secondary">
                    @game.LastPlay
                </div>
            </div>
        }
    </div>
</section>
