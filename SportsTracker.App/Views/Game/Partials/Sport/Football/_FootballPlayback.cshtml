@using System.Text.Json
@using SportsTracker.App.Models.Sport
@model SportsTracker.App.ViewModels.GameDetails.GameDetailsViewModel

@{
    IReadOnlyList<FootballPlaybackPlay> plays = Model.HistoricalFootballPlays;
    
    int initialIndex = 0;
    
    FootballPlaybackPlay initialPlay = plays[initialIndex];
    
    string json = JsonSerializer.Serialize(plays, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="football-playback mt-4 pt-3 border-top" data-football-playback data-initial-index="@initialIndex">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-4">Historical Game Playback</h6>
        
        <span class="badge bg-secondary">
            Development Preview
        </span>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-semibold" data-playback-clock>
            Q@(initialPlay.Quarter) - @initialPlay.Clock
        </span>
        
        <span class="text-secondary small" data-playback-count>
            Play @(initialIndex + 1) of @plays.Count
        </span>
    </div>
    
    <div class="mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="small text-secondary" data-playback-drive>
                Drive @initialPlay.DriveNumber
            </span>
            
            <span class="badge bg-success football-playback-event" data-playback-scroring hidden></span>
            
            <span class="badge bg-info text-dark football-playback-event" data-playback-possession-change hidden>
                Change of Possession
            </span>
        </div>
        
        <div class="football-playback-description fw-medium" data-playback-description>
            @initialPlay.Description
        </div>
        
        <div class="small text-secondary mt-2" data-playback-score>
            @Model.AwayTeam.Abbreviation:
            @(initialPlay.AwayScore?.ToString() ?? "-")
            |
            @Model.HomeTeam.Abbreviation:
            @(initialPlay.HomeScore?.ToString() ?? "-")
        </div>
    </div>
    
    <div class="football-playback-timeline mb-3">
        <label class="form-label small text-secondary mb-2" for="football-playback-seek">
            Playback Timeline
        </label>
        
        <input type="range" class="form-range football-playback-seek" id="football-playback-seek" data-playback-seek min="0" max="@(plays.Count - 1)" step="1" value="@initialIndex" aria-label="Seek to Play" />
        
        <div class="d-flex justify-content-between small text-secondary">
            <span data-playback-current-play>Play @(initialIndex + 1)</span>
            <span>Play @plays.Count</span>
        </div>
    </div>
    
    <div class="football-playback-controls d-flex flex-wrap align-items-center justify-content-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-playback-action="first" title="First Play">
            <i class="bi bi-skip-backward-fill"></i>
            First
        </button>

        <button type="button" class="btn btn-outline-secondary btn-sm" data-playback-action="previous" title="Previous Play">
            <i class="bi bi-chevron-left"></i>
            Previous
        </button>

        <button type="button" class="btn btn-primary btn-sm football-playback-toggle" data-playback-action="toggle" aria-label="Play" aria-pressed="false">
            <i class="bi bi-play-fill" data-playback-toggle-icon></i>
            <span data-playback-toggle-label>Play</span>
        </button>

        <button type="button" class="btn btn-outline-secondary btn-sm" data-playback-action="next" title="Next Play">
            Next
            <i class="bi bi-chevron-right"></i>
        </button>

        <button type="button" class="btn btn-outline-secondary btn-sm" data-playback-action="last" title="Last Play">
            Last
            <i class="bi bi-skip-forward-fill"></i>
        </button>
        
        <button type="button" class="btn btn-outline-secondary btn-sm" data-playback-action="previous-drive" title="Previous Drive">
            <i class="bi bi-skip-start"></i>
            Previous Drive
        </button>

        <button type="button" class="btn btn-outline-secondary btn-sm" data-playback-action="next-drive" title="Next Drive">
            Next Drive
            <i class="bi bi-skip-end"></i>
        </button>

        <div class="football-playback-speed d-flex align-items-center gap-2">
            <label for="football-playback-speed" class="small text-secondary mb-0">
                Speed
            </label>

            <select id="football-playback-speed" class="form-select form-select-sm" data-playback-speed aria-label="Playback speed">
                <option value="0.5">0.5×</option>
                <option value="1" selected>1×</option>
                <option value="2">2×</option>
                <option value="4">4×</option>
            </select>
        </div>
    </div>
    
    <div class="text-center small text-secondary mt-3" data-playback-status role="status" aria-live="polite">
        Select a Play to Update the Field
    </div>
    
    <script type="application/json" data-playback-data>
        @Html.Raw(json)
    </script>
</div>