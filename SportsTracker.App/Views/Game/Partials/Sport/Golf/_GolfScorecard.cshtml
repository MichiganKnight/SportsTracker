@using SportsTracker.App.ViewModels.Golf
@model SportsTracker.App.ViewModels.Golf.GolfLeaderboardRowViewModel

<div class="golf-player-scorecard">
    @foreach (GolfRoundViewModel round in Model.Rounds.OrderBy(r => r.Round))
    {
        <div class="golf-round-scorecard mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-semibold">
                    Round @round.Round
                </div>
                
                <div class="text-secondary small">
                    @if (round.Strokes.HasValue)
                    {
                        <span>
                            @round.Strokes Strokes
                        </span>
                    }
                    
                    @if (!string.IsNullOrWhiteSpace(round.ScoreToPar))
                    {
                        <span class="ms-2">
                            @round.ScoreToPar
                        </span>
                    }
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-sm golf-scorecard-table mb-0">
                    <thead>
                        <tr>
                            <th>Hole</th>
                            
                            @foreach (GolfHoleViewModel hole in round.Holes.OrderBy(r => r.Hole))
                            {
                                <th class="text-center">
                                    @hole.Hole
                                </th>
                            }
                            
                            <th class="text-center">
                                Total
                            </th>
                        </tr>
                    </thead>
                    
                    <tbody>
                        <tr>
                            <th>
                                Score
                            </th>
                            
                            @foreach (GolfHoleViewModel hole in round.Holes.OrderBy(hole => hole.Hole))
                            {
                                <td class="text-center">
                                    <span class="@GetScoreClass(hole.ScoreToPar)" title="@GetScoreName(hole.ScoreToPar)">
                                        @(hole.Strokes?.ToString() ?? "-")
                                    </span>
                                </td>
                            }
                            
                            <td class="text-center fw-bold">
                                @(round.Strokes?.ToString() ?? "-")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@functions
{
    private static string GetScoreClass(string? scoreToPar)
    {
        if (string.IsNullOrWhiteSpace(scoreToPar) || scoreToPar.Equals("E", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        if (!int.TryParse(scoreToPar, out int score))
        {
            return string.Empty;
        }

        return score switch
        {
            <= -2 => "golf-score-eagle",
            -1 => "golf-score-birdie",
            1 => "golf-score-bogey",
            >= 2 => "golf-score-double-bogey",
            _ => string.Empty
        };
    }

    private static string GetScoreName(string? scoreToPar)
    {
        if (string.IsNullOrWhiteSpace(scoreToPar))
        {
            return string.Empty;
        }

        if (scoreToPar.Equals("E", StringComparison.OrdinalIgnoreCase))
        {
            return "Par";
        }

        if (!int.TryParse(scoreToPar, out int score))
        {
            return string.Empty;
        }
        
        return score switch
        {
            <= -3 => "Albatross or Better",
            -2 => "Eagle",
            -1 => "Birdie",
            1 => "Bogey",
            2 => "Double Bogey",
            >= 3 => "Triple Bogey or Worse",
            _ => "Par"
        };
    }
}