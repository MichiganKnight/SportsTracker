@using SportsTracker.App.ViewModels.AthleteInfo
@model SportsTracker.App.ViewModels.AthleteInfo.AthleteGameLogViewModel

<div data-athlete-gamelog>
    @if (!Model.HasGames)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x fs-2 text-secondary"></i>

                <h5 class="mt-3 mb-2">
                    Game Log Not Available
                </h5>

                <div class="text-secondary">
                    No Game Log Data is Available for This Athlete
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model.Seasons.Count > 1)
        {
            <div class="athlete-gamelog-season-nav mb-4">
                <div class="btn-group" role="group" aria-label="Game Log Season Type">
                    @for (int i = 0; i < Model.Seasons.Count; i++)
                    {
                        AthleteGameLogSeasonViewModel season = Model.Seasons[i];

                        <button type="button" class="btn btn-sm athlete-gamelog-season-button @(i == 0 ? "btn-primary" : "btn-outline-secondary")" data-athlete-gamelog-season="@i">
                            @season.DisplayName
                        </button>
                    }
                </div>
            </div>
        }

        @for (int seasonIndex = 0; seasonIndex < Model.Seasons.Count; seasonIndex++)
        {
            AthleteGameLogSeasonViewModel season = Model.Seasons[seasonIndex];

            <div class="athlete-gamelog-season @(seasonIndex == 0 ? "" : "d-none")" data-athlete-gamelog-season-panel="@seasonIndex">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        @season.DisplayName
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(season.TeamAbbreviation))
                    {
                        <span class="text-secondary fw-semibold">
                        @season.TeamAbbreviation
                    </span>
                    }
                </div>

                @foreach (AthleteGameLogCategoryViewModel category in season.Categories)
                {
                    <div class="card athlete-gamelog-card shadow-sm mb-4">
                        <div class="card-header athlete-section-header">
                            @(string.IsNullOrWhiteSpace(category.DisplayName) ? "Game Log" : category.DisplayName)
                        </div>

                        <div class="table-responsive athlete-gamelog-table-wrap">
                            <table class="table athlete-gamelog-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="athlete-gamelog-date-column">
                                            Date
                                        </th>

                                        <th class="athlete-gamelog-opponent-column">
                                            Opponent
                                        </th>

                                        <th class="text-center athlete-gamelog-result-column">
                                            Result
                                        </th>

                                        @foreach (AthleteGameLogColumnViewModel column in Model.Columns)
                                        {
                                            <th class="text-center" title="@column.DisplayName">
                                                @column.Label
                                            </th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (AthleteGameLogGameViewModel game in category.Games)
                                    {
                                        <tr>
                                            <td class="athlete-gamelog-date">
                                                @game.DateDisplay
                                            </td>

                                            <td>
                                                <a asp-controller="Game" asp-action="Index" asp-route-league="@Model.League" asp-route-gameId="@game.EventId" class="athlete-gamelog-opponent-link">
                                                    @if (!string.IsNullOrWhiteSpace(game.OpponentLogo))
                                                    {
                                                        <img src="@game.OpponentLogo" alt="@game.OpponentName" class="athlete-gamelog-opponent-logo"/>
                                                    }

                                                    <span class="text-secondary">
                                                    @game.AtVs
                                                </span>

                                                    <span class="fw-semibold">
                                                    @game.OpponentAbbreviation
                                                </span>
                                                </a>

                                                @if (!string.IsNullOrWhiteSpace(game.EventNote))
                                                {
                                                    <div class="athlete-gamelog-note">
                                                        @game.EventNote
                                                    </div>
                                                }
                                            </td>

                                            <td class="text-center athlete-gamelog-result">
                                                <div class="athlete-gamelog-result">
                                                <span class="@(game.IsWin ? "text-success" : game.IsLoss ? "text-danger" : "text-secondary") fw-bold">
                                                    @game.Result
                                                </span>

                                                    @if (!string.IsNullOrWhiteSpace(game.Score))
                                                    {
                                                        <span class="athlete-gamelog-score">
                                                        @game.Score
                                                    </span>
                                                    }
                                                </div>
                                            </td>

                                            @for (int i = 0; i < Model.Columns.Count; i++)
                                            {
                                                string value = i < game.Stats.Count ? game.Stats[i] : string.Empty;

                                                <td class="text-center athlete-gamelog-stat">
                                                    @value
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>

                                @if (category.Totals.Count > 0)
                                {
                                    <tfoot>
                                        <tr>
                                            <th colspan="3">
                                                Total
                                            </th>

                                            @for (int i = 0; i < Model.Columns.Count; i++)
                                            {
                                                string value = i < category.Totals.Count ? category.Totals[i] : string.Empty;

                                                <td class="text-center">
                                                    @value
                                                </td>
                                            }
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>