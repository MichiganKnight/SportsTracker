    ViewData["ActiveAthleteTab"] = "Stats";
}

<div class="container-fluid athlete-page">
    <partial name="~/Views/Athlete/Partials/_AthleteHeader.cshtml" model="Model.Athlete" />
    
    <partial name="~/Views/Athlete/Partials/_AthleteNavigation.cshtml" model="Model.Athlete" />
    
    <partial name="~/Views/Athlete/Partials/_AthleteStats.cshtml" model="Model.Content" />
</div>