@model SportsTracker.App.ViewModels.AthleteInfo.AthleteDetailsViewModel

@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="container-fluid athlete-page">
    <partial name="~/Views/Athlete/Partials/_AthleteHeader.cshtml" model="Model" />
    
    @if (Model.HasStatsSummary)
    {
        <partial name="~/Views/Athlete/Partials/_AthleteQuickStats.cshtml" model="Model" />   
    }
    
    <partial name="~/Views/Athlete/Partials/_AthleteBio.cshtml" model="Model" />   
</div>