@using SportsTracker.App.Enums
@using SportsTracker.App.ViewModels.LeagueInfo
@using SportsTracker.App.ViewModels.Standings
@model SportsTracker.App.ViewModels.Standings.StandingsViewModel

@{
    ViewData["Title"] = $"{Model.LeagueName} Standings";
}

<div class="container-fluid">
    <!-- League Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @Model.LeagueName
            </h1>

            <div class="text-secondary">
                @Model.Season Standings
            </div>
        </div>

        <partial name="Navigation/_LeagueNavigation" model="new LeagueNavigationViewModel
                 {
                     League = Model.League,
                     LeagueName = Model.LeagueName,
                     ActivePage = LeaguePage.Standings
                 }"/>
    </div>

    <!-- Standings View Filter -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            Standings
        </h4>

        <div class="btn-group" role="group" aria-label="Standings View">

            @foreach (StandingsView standingsView in Model.AvailableViews)
            {
                bool active = standingsView == Model.SelectedView;

                <a asp-controller="Standings" asp-action="Index" asp-route-league="@Model.League" asp-route-view="@standingsView" class="btn btn-sm @(active ? "btn-primary" : "btn-outline-secondary")">
                    @GetViewLabel(standingsView, Model.League)
                </a>
            }
        </div>
    </div>

    <!-- Standings Groups -->
    @foreach (StandingsGroupViewModel group in Model.Groups)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header standings-group-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @group.Name
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(group.Abbreviation))
                    {
                        <span class="standings-group-abbreviation">
                            @group.Abbreviation
                        </span>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 standings-table">
                    <thead>
                        <tr>
                            <th class="standings-rank">#</th>

                            <th>Team</th>

                            <th class="text-end">W</th>

                            <th class="text-end">L</th>

                            @if (Model.ShowTies)
                            {
                                <th class="text-end">T</th>
                            }

                            <th class="text-end">PF</th>
                            
                            <th class="text-end">PA</th>
                            
                            <th class="text-end">PCT</th>

                            @if (Model.ShowGamesBack)
                            {
                                <th class="text-end">GB</th>
                            }

                            @if (Model.ShowDifferential)
                            {
                                <th class="text-end">DIFF</th>
                            }

                            @if (Model.ShowStreak)
                            {
                                <th class="text-end">STRK</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < group.Teams.Count; i++)
                        {
                            TeamStandingViewModel team = group.Teams[i];

                            <tr>
                                <td class="text-secondary standings-rank">
                                    @(i + 1)
                                </td>

                                <td class="standings-team">
                                    <a asp-controller="Team" asp-action="Index" asp-route-league="@Model.League" asp-route-teamId="@team.TeamId" class="team-link">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(team.Logo))
                                            {
                                                <span class="standings-team-logo-wrap">
                                                    <img class="standings-team-logo" src="@team.Logo" alt="@team.Name" />
                                                </span>
                                            }
                                            
                                            <div class="standings-team-info">
                                                <span class="standings-team-name">
                                                    @team.Name
                                                </span>

                                                <span class="standings-team-abbreviation">
                                                    @team.Abbreviation
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                </td>

                                <td class="text-end">
                                    @team.Wins
                                </td>

                                <td class="text-end">
                                    @team.Losses
                                </td>

                                @if (Model.ShowTies)
                                {
                                    <td class="text-end">
                                        @(team.Ties ?? 0)
                                    </td>
                                }
                                
                                <td class="text-end">
                                    @team.PointsFor
                                </td>
                                
                                <td class="text-end">
                                    @team.PointsAgainst
                                </td>

                                <td class="text-end">
                                    @team.WinPercentageDisplay
                                </td>

                                @if (Model.ShowGamesBack)
                                {
                                    <td class="text-end">
                                        @team.GamesBackDisplay
                                    </td>
                                }

                                @if (Model.ShowDifferential)
                                {
                                    <td class="text-end">
                                        @if (team.PointDifferential is not null)
                                        {
                                            <span class="@GetDifferentialClass(team.PointDifferential.Value)">
                                                @team.PointDifferential.Value.ToString("+0;-0;0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                }

                                @if (Model.ShowStreak)
                                {
                                    <td class="text-end">
                                        @(team.Streak ?? "-")
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@functions
{
    private static string GetViewLabel(StandingsView view, League league)
    {
        return view switch
        {
            StandingsView.Overall => "Overall",
            StandingsView.League when league == League.MLB => "League",
            StandingsView.Conference => "Conference",
            StandingsView.Division => "Division",

            _ => view.ToString()
        };
    }

    private static string GetDifferentialClass(int differential)
    {
        return differential switch
        {
            > 0 => "standings-positive",
            < 0 => "standings-negative",
            _ => "text-secondary"
        };
    }
}