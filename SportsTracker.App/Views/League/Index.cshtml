@using SportsTracker.App.ViewModels.Golf
@model SportsTracker.App.ViewModels.LeagueInfo.LeaguePageViewModel

@{
    ViewData["Title"] = Model.LeagueName;
}

<div class="container-fluid">
    <!-- League Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @Model.LeagueName
            </h1>
            
            <div class="text-secondary small">
                Last Updated: @Model.LastUpdatedUtc.ToLocalTime().ToString("g")
            </div>
        </div>
    </div>
    
    @if (Model.IsGolf)
    {
        if (!Model.HasGolfEvents)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="text-secondary">
                        No Tournaments Available
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (GolfEventCardViewModel golfEvent in Model.GolfEvents)
                {
                    <div class="col-12 col-xl-6">
                        <partial name="~/Views/Game/Partials/Sport/Golf/_GolfEventCard.cshtml" model="golfEvent" />
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- Game Sections -->
        <partial name="Partials/_LeagueGameSections" model="Model" />
    }
</div>