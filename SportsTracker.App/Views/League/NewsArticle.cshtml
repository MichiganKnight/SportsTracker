@using SportsTracker.App.Enums
@using SportsTracker.App.ViewModels.LeagueInfo
@model SportsTracker.App.ViewModels.LeagueInfo.LeagueNewsArticlePageViewModel

@{
    ViewData["Title"] = $"{Model.Headline} - {Model.LeagueName}";
}

<div class="container-fluid">
    <!-- League Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @Model.LeagueName
            </h1>

            <div class="text-secondary">
                Latest News
            </div>
        </div>

        <partial name="Navigation/_LeagueNavigation"
                 model="new LeagueNavigationViewModel
                 {
                     League = Model.League,
                     LeagueName = Model.LeagueName,
                     ActivePage = LeaguePage.News
                 }"/>
    </div>
    
    <div class="news-article-container">
        <!-- Back -->
        <div class="mb-4">
            <a asp-controller="League" asp-action="News" asp-route-league="@Model.League" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back to @Model.LeagueName News
            </a>
        </div>
        
        <article>
            <!-- Article Header -->
            <header class="news-article-header">
                @if (Model.Premium || string.Equals(Model.Type, "Media", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @if (Model.Premium)
                        {
                            <span class="badge text-bg-warning">
                                ESPN+
                            </span>
                        }
                        
                        @if (string.Equals(Model.Type, "Media", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-secondary">
                                Video
                            </span>
                        }
                    </div>
                }
                
                <h2 class="news-article-headline">
                    @Model.Headline
                </h2>
                
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="news-article-description text-secondary">
                        @Model.Description
                    </p>
                }
                
                <div class="news-articlem-meta text-secondary">
                    @if (!string.IsNullOrWhiteSpace(Model.Byline))
                    {
                        <span>
                            By @Model.Byline
                        </span>
                    }
                    
                    @if (Model.Published.HasValue)
                    {
                        <span class="@(!string.IsNullOrWhiteSpace(Model.Byline) ? "news-article-meta-separator" : string.Empty)">
                            @Model.Published.Value.ToLocalTime().ToString("MMMM dd, yyyy - hh:mm tt")
                        </span>
                    }
                </div>
            </header>
            
            <!-- Header Image -->
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <figure class="news-article-figure">
                    <img src="@Model.ImageUrl" alt="@Model.ImageAlt" class="news-article-image" />
                    
                    @if (!string.IsNullOrWhiteSpace(Model.ImageCaption) || !string.IsNullOrWhiteSpace(Model.ImageCredit))
                    {
                        <figcaption class="news-article-caption text-secondary">
                            @if (!string.IsNullOrWhiteSpace(Model.ImageCaption))
                            {
                                <span>
                                    @Model.ImageCaption
                                </span>
                            }
                            
                            @if (!string.IsNullOrWhiteSpace(Model.ImageCredit))
                            {
                                <span>
                                    @if (!string.IsNullOrWhiteSpace(Model.ImageCaption))
                                    {
                                        <text> - </text>
                                    }
                                    
                                    @Model.ImageCredit
                                </span>
                            }
                        </figcaption>
                    }
                </figure>
            }
            
            <!-- Article Body -->
            <div class="news-article-body-card">
                <div class="league-news-article-body">
                    @Html.Raw(Model.Story)
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ArticleUrl))
                {
                    <footer class="news-article-footer text-secondary small">
                        Original Reporting:
                        <a href="@Model.ArticleUrl" target="_blank" rel="noopener noreferrer">
                            ESPN
                        </a>
                    </footer>
                }
            </div>
        </article>
    </div>
</div>