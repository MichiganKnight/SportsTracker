@using SportsTracker.App.Enums
@using SportsTracker.App.ViewModels.LeagueInfo
@model SportsTracker.App.ViewModels.LeagueInfo.LeagueNewsArticlePageViewModel

@{
    ViewData["Title"] = $"{Model.Headline} - {Model.LeagueName}";
}

<div class="container-fluid">
    <!-- League Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                @Model.LeagueName
            </h1>

            <div class="text-secondary">
                Latest News
            </div>
        </div>

        <partial name="Navigation/_LeagueNavigation"
                 model="new LeagueNavigationViewModel
                 {
                     League = Model.League,
                     LeagueName = Model.LeagueName,
                     ActivePage = LeaguePage.News
                 }"/>
    </div>
    
    <!-- Back -->
    <div class="mb-3">
        <a asp-controller="League" asp-action="News" asp-route-league="@Model.League" class="btn btn-sm btn-outline-secondary">
            &larr; Back to @Model.LeagueName News
        </a>
    </div>
    
    <!-- Article -->
    <article class="card shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <!-- Article Header -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    @if (Model.Premium)
                    {
                        <span class="badge text-bg-warning">
                            ESPN+
                        </span>
                    }
                    
                    @if (string.Equals(Model.Type, "Media", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge text-bg-secondary">
                            Video
                        </span>
                    }
                </div>
                
                <h2 class="mb-3">
                    @Model.Headline
                </h2>
                
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="lead text-secondary mb-3">
                        @Model.Description
                    </p>
                }
                
                <div class="d-flex flex-wrap gap-3 text-secondary small">
                    @if (!string.IsNullOrWhiteSpace(Model.Byline))
                    {
                        <span>
                            @Model.Byline
                        </span>
                    }
                    
                    @if (Model.Published.HasValue)
                    {
                        <span>
                            @Model.Published.Value.ToLocalTime().ToString("MMM d, yyyy - h:mm tt")
                        </span>
                    }
                </div>
            </div>
            
            <!-- Header Image -->
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <figure class="mb-4">
                    <img src="@Model.ImageUrl" alt="@Model.ImageAlt" class="img-fluid rounded w-100" style="max-height: 600px; object-fit: cover;" />

                    @if (!string.IsNullOrWhiteSpace(Model.ImageCaption) || !string.IsNullOrWhiteSpace(Model.ImageCredit))
                    {
                        <figcaption class="text-secondary small mt-2">
                            @if (!string.IsNullOrWhiteSpace(Model.ImageCaption))
                            {
                                <span>
                                    @Model.ImageCaption
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.ImageCredit))
                            {
                                <span>
                                    @if (!string.IsNullOrWhiteSpace(Model.ImageCaption))
                                    {
                                        <text> - </text>
                                    }

                                    @Model.ImageCredit
                                </span>
                            }

                        </figcaption>
                    }
                </figure>
            }
            
            <hr class="my-4" />

            <!-- Article Body -->
            <div class="league-news-article-body">
                @Html.Raw(Model.Story)
            </div>
            
            <!-- Source -->
            @if (!string.IsNullOrWhiteSpace(Model.ArticleUrl))
            {
                <hr class="my-4" />

                <div class="text-secondary small">
                    Source:
                    <a href="@Model.ArticleUrl" target="_blank" rel="noopener noreferrer">
                        ESPN
                    </a>
                </div>
            }
        </div>
    </article>
</div>