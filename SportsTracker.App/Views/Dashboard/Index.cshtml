@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h2 class="mb-1">
                Today's Games
            </h2>
            
            <p class="text-secondary mb-0">
                Live Scoreboards from Every Supported League
            </p>
        </div>
    </div>
    
    @foreach (dynamic? league in Model.Leagues)
    {
        <partial name="~/Views/Shared/Dashboard/_LeagueSection.cshtml" model="league" />
    }
</div>