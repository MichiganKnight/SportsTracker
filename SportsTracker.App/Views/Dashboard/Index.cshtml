@model SportsTracker.App.ViewModels.DashboardInfo.DashboardOverviewViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveDashboardTab"] = "Overview";
}

<div class="container-fluid dashboard-page">
    <partial name="~/Views/Dashboard/Partials/_DashboardHeader.cshtml"/>

    <partial name="~/Views/Dashboard/Partials/_DashboardNavigation.cshtml"/>

    <partial name="~/Views/Dashboard/Partials/_FollowingSummary.cshtml"/>

    <div class="row g-4">
        <div class="col-lg-5">
            <partial name="~/Views/Dashboard/Partials/_LiveSummary.cshtml" model="Model.LiveEvents"/>
        </div>
        
        <div class="col-lg-7">
            <partial name="~/Views/Dashboard/Partials/_LeaguesSummary.cshtml" model="Model.Leagues"/>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard/dashboardOverview.js" asp-append-version="true"></script>
}