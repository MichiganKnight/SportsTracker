@using SportsTracker.App.ViewModels.LeagueInfo
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid dashboard-page">
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h2 class="mb-1">
                Today's Games
            </h2>

            <p class="text-secondary mb-0">
                Live Scoreboards from Every Supported League
            </p>
        </div>
    </div>
    
    <section id="dashboard-favorites-empty" class="dashboard-favorites-empty mb-5 d-none">
        <div class="dashboard-favorites-empty-icon">
            <i class="bi bi-star"></i>
        </div>
        
        <div>
            <div class="fw-semibold">
                Personalize Your Dashboard
            </div>
            
            <div class="text-secondary small">
                Follow Teams to See Their Games and Updates Here
            </div>
        </div>
    </section>
    
    <section id="dashboard-favorite-teams" class="dashboard-feature-section mb-5 d-none">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h5 mb-1">
                    <i class="bi bi-people-fill text-primary me-1"></i>
                    Favorite Teams
                </h3>
                
                <div class="text-secondary small">
                    Teams You Follow
                </div>
            </div>
        </div>
        
        <div id="dashboard-favorite-team-list" class="dashboard-favorite-team-list"></div>
    </section>

    <section id="dashboard-favorites" class="dashboard-feature-section mb-5 d-none">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h5 mb-1">
                    <i class="bi bi-star-fill text-warning me-1"></i>
                    Favorite Games
                </h3>

                <div class="text-secondary small">
                    Games Involving Teams You Follow
                </div>
            </div>
        </div>

        <div id="dashboard-favorite-games" class="row g-3"></div>
    </section>

    <section id="dashboard-live" class="dashboard-feature-section mb-5 d-none">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h5 mb-1">
                    <span class="game-live-dot me-1"></span>
                    Live Now
                </h3>

                <div class="text-secondary small">
                    Games Currently in Progress
                </div>
            </div>
        </div>

        <div id="dashboard-live-games" class="row g-3"></div>
    </section>

    <div id="dashboard-leagues">
        @foreach (LeagueSectionViewModel league in Model.Leagues)
        {
            <partial name="~/Views/Shared/Dashboard/_LeagueSection.cshtml" model="league"/>
        }
    </div>
</div>