@using SportsTracker.App.ViewModels.DashboardInfo;
@model IReadOnlyList<DashboardLeagueSummaryViewModel>

<div class="card shadow-sm dashboard-summary-card h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <h5 class="card-title mb-1">
                    Leagues
                </h5>

                <p class="text-secondary mb-0">
                    Browse supported sports and leagues
                </p>
            </div>

            <a asp-controller="Dashboard" asp-action="Leagues" class="btn btn-outline-secondary btn-sm">
                View Leagues
            </a>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            @foreach (DashboardLeagueSummaryViewModel league in Model)
            {
                <a asp-controller="League" asp-action="Index" asp-route-league="@league.League" class="dashboard-league-summary-item">
                    @if (!string.IsNullOrWhiteSpace(league.Icon))
                    {
                        <span class="dashboard-league-summary-icon">
                            @league.Icon
                        </span>
                    }
                    
                    <span class="dashboard-league-summary-name">
                        @league.LeagueName
                    </span>
                </a>
            }
        </div>
    </div>
</div>