@using SportsTracker.App.Models.TeamInfo
@model SportsTracker.App.ViewModels.TeamInfo.TeamInjuriesViewModel

@{
    ViewData["Title"] = $"{Model.Team.Team.DisplayName} Injuries";
    ViewData["ActiveTeamTab"] = "Injuries";
}

<div class="container-fluid">
    <partial name="Partials/_TeamHeader" model="Model.Team"/>

    <partial name="Partials/_TeamNavigation" model="Model.Team"/>

    @if (Model.Injuries.Count == 0)
    {
        <div class="card">
            <div class="card-body">
                No Injuries Reported
            </div>
        </div>
    }
    else
    {
        <section class="team-injuries">
            <div class="team-section-heading">
                <div>
                    <h2>Injury Report</h2>
                    <p>
                        @Model.Injuries.Count
                        @(Model.Injuries.Count == 1 ? "player" : "players")
                        Currently Listed
                    </p>
                </div>
            </div>

            <div class="team-injuries-list">
                @foreach (TeamInjury injury in Model.Injuries)
                {
                    string statusClass = injury.Status.ToLowerInvariant() switch
                    {
                        "questionable" => "team-injury-status-questionable",
                        "doubtful" => "team-injury-status-doubtful",
                        "out" => "team-injury-status-out",
                        "injured reserve" => "team-injury-status-ir",
                        
                        _ => "team-injury-status-default"
                    };

                    string collapseId = $"injury-{injury.Id.Replace("-", "")}";

                    <article class="team-injury-card">
                        <div class="team-injury-main">
                            <div class="team-injury-player-column">
                                <div class="team-injury-headshot">
                                    @if (!string.IsNullOrWhiteSpace(injury.Athlete?.HeadshotUrl))
                                    {
                                        <img src="@injury.Athlete.HeadshotUrl" alt="@injury.Athlete.DisplayName"/>
                                    }
                                    else
                                    {
                                        <div class="team-injury-headshot-placeholder">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                    }
                                </div>
                                
                                <div class="team-injury-player">
                                    @if (injury.Athlete is not null)
                                    {
                                        <a asp-controller="Athlete" asp-action="Index" asp-route-league="@Model.League" asp-route-athleteId="@injury.Athlete.Id" class="team-injury-player-name">
                                            @injury.Athlete.DisplayName
                                        </a>

                                        <div class="team-injury-player-meta">
                                            @if (!string.IsNullOrWhiteSpace(injury.Athlete.Jersey))
                                            {
                                                <span>#@injury.Athlete.Jersey</span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(injury.Athlete.PositionAbbreviation))
                                            {
                                                <span>
                                                    @injury.Athlete.PositionAbbreviation
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="team-injury-type">
                                <span class="team-injury-column-label">
                                    Injury
                                </span>

                                <span class="team-injury-column-value">
                                    @(injury.Details?.Type ?? "—")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(injury.Details?.Location))
                                {
                                    <span class="team-injury-secondary">
                                        @injury.Details.Location
                                    </span>
                                }
                            </div>

                            <div class="team-injury-return">
                                <span class="team-injury-column-label">
                                    Expected Return
                                </span>

                                <span class="team-injury-column-value">
                                    @(injury.Details?.ReturnDate?.ToString("MMM d, yyyy") ?? "—")
                                </span>
                            </div>

                            <div class="team-injury-status-container">
                                <span class="team-injury-status @statusClass">
                                    @injury.Status
                                </span>
                            </div>

                            <button class="team-injury-expand" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" title="View injury details">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(injury.ShortComment))
                        {
                            <div class="team-injury-summary">
                                @injury.ShortComment
                            </div>
                        }

                        <div class="collapse" id="@collapseId">
                            <div class="team-injury-expanded">
                                <div class="team-injury-details-grid">
                                    <div>
                                        <span class="team-injury-detail-label">
                                            Injury
                                        </span>
                                        <span class="team-injury-detail-value">
                                            @(injury.Details?.Type ?? "—")
                                        </span>
                                    </div>

                                    <div>
                                        <span class="team-injury-detail-label">
                                            Location
                                        </span>
                                        <span class="team-injury-detail-value">
                                            @(injury.Details?.Location ?? "—")
                                        </span>
                                    </div>

                                    <div>
                                        <span class="team-injury-detail-label">
                                            Side
                                        </span>
                                        <span class="team-injury-detail-value">
                                            @(injury.Details?.Side ?? "—")
                                        </span>
                                    </div>

                                    <div>
                                        <span class="team-injury-detail-label">
                                            Detail
                                        </span>
                                        <span class="team-injury-detail-value">
                                            @(injury.Details?.Detail ?? "—")
                                        </span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(injury.LongComment) && injury.LongComment != injury.ShortComment)
                                {
                                    <div class="team-injury-report">
                                        <span class="team-injury-detail-label">
                                            Injury Update
                                        </span>

                                        <p>@injury.LongComment</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>