@using SportsTracker.App.ViewModels.TeamInfo
@model SportsTracker.App.ViewModels.TeamInfo.TeamRosterPageViewModel

@{
    ViewData["Title"] = $"{Model.Team.Team.DisplayName} Roster";
    ViewData["ActiveTeamTab"] = "Roster";
}

<div class="container-fluid">
    <partial name="Partials/_TeamHeader" model="Model.Team" />
    
    <partial name="Partials/_TeamNavigation" model="Model.Team" />
    
    @foreach (RosterGroupViewModel group in Model.Groups)
    {
        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="mb-0">
                    @group.Name
                </h4>
                
                <span class="text-secondary small">
                    @group.Players.Count Players
                </span>
            </div>
            
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table  align-middle mb-0 roster-table">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Pos</th>
                                <th>Age</th>
                                <th>Height</th>
                                <th>Weight</th>
                                <th>B/T</th>
                                <th>Exp</th>
                            </tr>
                        </thead>
                        
                        <tbody>
                            @foreach (RosterPlayerViewModel player in group.Players)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrWhiteSpace(player.Headshot))
                                            {
                                                <img src="@player.Headshot" alt="@player.DisplayName" class="roster-player-headshot" />
                                            }
                                            
                                            <div>
                                                <div class="fw-semibold">
                                                    @if (!string.IsNullOrWhiteSpace(player.Jersey))
                                                    {
                                                        <span class="text-secondary me-1">
                                                            #@player.Jersey
                                                        </span>
                                                    }
                                                    
                                                    @player.DisplayName
                                                </div>
                                                
                                                @if (!string.IsNullOrWhiteSpace(player.BirthPlace))
                                                {
                                                    <div class="text-secondary small">
                                                        @player.BirthPlace
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <td>
                                        @(player.PositionAbbreviation ?? "-")
                                    </td>
                                    
                                    <td>
                                        @(player.Age?.ToString() ?? "-")
                                    </td>
                                    
                                    <td>
                                        @(player.Height ?? "-")
                                    </td>
                                    
                                    <td>
                                        @(player.Weight ?? "-")
                                    </td>
                                    
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(player.Bats) || !string.IsNullOrWhiteSpace(player.Throws))
                                        {
                                            <span>
                                                @(player.Bats ?? "-") / @(player.Throws ?? "-")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    
                                    <td>
                                        @(player.ExperienceYears.HasValue ? $"{player.ExperienceYears} yr" : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
</div>